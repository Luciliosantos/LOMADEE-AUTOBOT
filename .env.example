# Lomadee API
LOMADEE_BASE_URL=https://api.lomadee.com.br
LOMADEE_PRODUCTS_PATH=/affiliate/products
LOMADEE_BRANDS_PATH=/affiliate/brands
LOMADEE_CAMPAIGNS_PATH=/affiliate/campaigns
